# --- Database ---
POSTGRES_DB=indicebbs
POSTGRES_USER=indicebbs
POSTGRES_PASSWORD=changeme_strong_password

# --- App ---
# BASE_URL is used for absolute links (email etc); leave with trailing slash off
BASE_URL=https://hub.c-innovation.com.br/bbs
ROOT_PATH=/bbs
SECRET_KEY=change_this_to_a_long_random_string
TZ=America/Sao_Paulo

# --- Authentik SSO (forward-auth headers) ---
# Which HTTP header carries the authenticated username / email / display name.
# These are the defaults sent by Authentik's embedded outpost.
AUTHENTIK_HEADER_EMAIL=x-authentik-email
AUTHENTIK_HEADER_USERNAME=x-authentik-username
AUTHENTIK_HEADER_NAME=x-authentik-name
AUTHENTIK_HEADER_GROUPS=x-authentik-groups

# Authentik group names (comma-separated inside the header value).
# Users in BBS_ADMIN_GROUP become admin, in BBS_EDITOR_GROUP become editor,
# everyone else authenticated is viewer.
BBS_ADMIN_GROUP=bbs-admin
BBS_EDITOR_GROUP=bbs-editor

# --- Dev fallback (when running outside the Hub / without Authentik headers) ---
# Set to 1 to enable. In production leave 0 or unset.
DEV_MODE=0
DEV_USER_EMAIL=dev@c-innovation.com.br
DEV_USER_NAME=Dev User
DEV_USER_ROLE=admin
